# Copy to a real environment (Vercel project settings, or a local .env) to enable
# the intake form. The form front end works without these, but submissions will
# not be delivered until RESEND_API_KEY is set.

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=

# Where intake submissions are emailed. Defaults to hello@ideacamp.co.
INTAKE_TO=hello@ideacamp.co

# The From address. Its domain must be verified in Resend.
INTAKE_FROM=Ideacamp <intake@ideacamp.co>
